function runTests() {
  const results = [];

  function check(label, actual, expected) {
    const pass = String(actual) === String(expected);
    results.push((pass ? 'PASS  ' : 'FAIL  ') + label +
                 '  got=' + actual + '  want=' + expected);
  }

  check('domain from bracketed', extractDomain('Priya <priya@acme.ai>'), 'acme.ai');
  check('domain from bare',      extractDomain('priya@acme.ai'),          'acme.ai');
  check('subdomain stripped',    extractDomain('a@mail.acme.com'),        'acme.com');
  check('co.in preserved',       extractDomain('a@acme.co.in'),           'acme.co.in');
  check('case folded',           extractDomain('A@ACME.AI'),              'acme.ai');
  check('malformed',             extractDomain('not-an-email'),           '');
  check('empty input',           extractDomain(''),                       '');

  check('free domain flagged',   isFreeEmailDomain('gmail.com'),          'true');
  check('company not flagged',   isFreeEmailDomain('acme.ai'),            'false');

  check('name: suffix',   normalizeCompanyName('Acme Technologies'),     'acme');
  check('name: dot ai',   normalizeCompanyName('Acme.ai'),               'acme');
  check('name: pvt ltd',  normalizeCompanyName('Acme Labs Pvt Ltd'),     'acme');
  check('name: two word', normalizeCompanyName('Bright Wheel'),          'brightwheel');
  check('name: empty',    normalizeCompanyName(''),                      '');

  Logger.log(results.join('\n'));
}
